API_ID=
API_HASH=
BOT_TOKEN=
ADMIN_IDS=

# Access control: comma-separated Telegram IDs for admins and permitted users.
# ADMIN_IDS=111
# ALLOWED_USERS=111,222

# Optional YouTube/site authentication and network route.
# If either cookie variable is enabled, the bot forces private mode.
# Paste full Netscape cookies.txt content into one hosting secret only; never commit it.
# COOKIES_TXT=
# Or use one-line base64 from: base64 -w0 www.youtube.com_cookies.txt
# COOKIES_B64=
# PROXY=http://username:password@host:port

# High-speed profile is the default. Set to custom to honor lower values below.
TRANSFER_PROFILE=fast
UPLOAD_WORKERS=16
CONNECTIONS=24
FRAGMENTS=24
