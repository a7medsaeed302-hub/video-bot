API_ID=
API_HASH=
BOT_TOKEN=
ADMIN_IDS=

# Access control: empty means public; comma-separated Telegram IDs make the bot private.
# ALLOWED_USERS=111,222

# Optional YouTube/site authentication and network route.
# Store these only in the hosting provider's secret variables, never in GitHub.
# COOKIES_TXT=
# PROXY=http://username:password@host:port

# High-speed profile is the default. Set to custom to honor lower values below.
TRANSFER_PROFILE=fast
UPLOAD_WORKERS=16
CONNECTIONS=24
FRAGMENTS=24
